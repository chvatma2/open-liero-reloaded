+}
+
+bool setWeapons(int wormId, const std::string& spec, std::string& err) {
+	CWorm* w = localWorm(wormId, err);
+	if(!w) return false;
+	std::vector<std::string> names;
+	int cur = 0;
+	std::istringstream in(spec);
+	std::string item;
+	while(std::getline(in, item, ',')) {
+		if(item.compare(0, 4, "cur=") == 0) {
+			bool bad = false;
+			cur = from_string<int>(item.substr(4), bad);
+			if(bad) { err = "bad " + item; return false; }
+		}
+		else
+			names.push_back(item);
+	}
+	const size_t slots = w->weaponSlots.get().size();
+	if(names.size() != slots) {
+		err = "worm " + itoa(wormId) + " has " + itoa((int)slots) + " weapon slots, got " + itoa((int)names.size()) + " names";
+		return false;
+	}
+	if(cur < 0 || (size_t)cur >= slots) { err = "bad current slot " + itoa(cur); return false; }
+	std::vector<int> ids;
+	for(size_t i = 0; i < names.size(); i++) {
+		int id = game.gameScript()->FindWeaponId(names[i]);
+		if(id < 0) { err = "no weapon '" + names[i] + "'"; return false; }
+		ids.push_back(id);
+	}
+	for(size_t i = 0; i < slots; i++) {
+		wpnslot_t& s = w->weaponSlots.write()[i];
+		s.WeaponId = ids[i];
+		s.Charge = 1.f;
+		s.Reloading = false;
+		s.LastFire = 0.f;
+	}
+	w->setCurrentWeapon(cur);
+	return true;
+}
+
+bool setHealth(int wormId, float hp, std::string& err) {
+	CWorm* w = localWorm(wormId, err);
+	if(!w) return false;
+	w->setHealth(hp);
+	return true;
+}
+
+bool placeBonus(int x, int y, const std::string& kind, const std::string& weapon, std::string& err) {
+	int type;
+	if(!bonusType(kind, type, err)) return false;
+	int wpn = -1;
+	if(type == BNS_WEAPON) {
+		wpn = game.gameScript()->FindWeaponId(weapon);
+		if(wpn < 0) { err = "no weapon '" + weapon + "'"; return false; }
+	}
+	PinnedClock pin;
+	CBytestream packet;
+	GameServer::GivenBonus given = { CVec((float)x, (float)y), type, wpn, &packet };
+	if(!cServer->SpawnBonus(&given)) { err = "no free bonus slot"; return false; }
+	// The client sees it now, as if the packet had arrived.
+	packet.ResetPosToBegin();
+	cClient->getNetEngine()->ParsePacket(&packet);
+	return true;
+}
+
+static long frameIndex() { return (long)game.serverFrame - g_base - 1; }
+
+void onGameOver(int winner) {
+	g_gameOverWinner = winner;
+}
+
+void beforeFrame() {
+	if(g_rec) {
+		g_wallTime = tLX->currentTime;
+		tLX->currentTime = pinnedTime();
+		g_pinned = true;
+	}
+	if(g_base < 0) return;
+	const long frame = frameIndex();
+	std::map<long, std::vector<Event> >::iterator it = g_plan.find(frame);
+	if(it != g_plan.end())
+		for(size_t i = 0; i < it->second.size(); i++)
+			apply(g_keys[it->second[i].worm], it->second[i].mask);
+	std::map<long, std::vector<BonusEvent> >::iterator bt = g_bonusPlan.find(frame);
+	if(bt != g_bonusPlan.end())
+		for(size_t i = 0; i < bt->second.size(); i++) {
+			const BonusEvent& b = bt->second[i];
+			std::string err;
+			if(!placeBonus(b.x, b.y, b.kind, b.weapon, err))
+				fail("frame " + itoa((int)frame) + ": " + err);
+		}
+	if(g_timing) g_frameStart = std::chrono::steady_clock::now();
+}
+
+void afterFrame() {
+	if(g_timing) {
+		const long long ns = (long long)std::chrono::duration_cast<std::chrono::nanoseconds>(
+			std::chrono::steady_clock::now() - g_frameStart).count();
+		auto& ps = cClient->getProjectiles();
+		int projectiles = 0;
+		for(int i = 0; i <= ps.lastUsed(); i++)
+			if(ps.isUsed(i)) projectiles++;
+		fprintf(g_timing, "%ld %lld %d %llu\n", frameIndex(), ns, projectiles, g_randCalls);
+	}
+	if(g_rec && !g_headerOnly) writeState(frameIndex());
+	if(g_pinned) {
+		tLX->currentTime = g_wallTime;
+		g_pinned = false;
+	}
+}
+
+// The reliable messages one side queued for the other on the local connection, in
+// queue order. Taking them out of the channel means the network never sends them.
+static std::list<CBytestream> takeMessages(CChannel* ch) {
+	std::list<CBytestream> out;
+	if(ch) out.swap(ch->Messages);
+	return out;
+}
+
+static std::string messageTypes(const std::list<CBytestream>& msgs) {
+	std::string out;
+	for(std::list<CBytestream>::const_iterator it = msgs.begin(); it != msgs.end(); ++it)
+		if(it->GetLength() > 0) out += " " + itoa((int)(uchar)it->data()[0]);
+	return out;
+}
+
+// Shot delivery, Model R (spec §18 D1): the shots added during frames F and F+1
+// form one list, which is encoded, decoded and processed after frame F+1, so
+// before frame F+2, like real play at one frame per main-loop iteration.
+static void deliverShots(CServerConnection* cl) {
+	CShootList* sl = cl->getShootList();
+	if(sl->getNumShots() == 0) return;
+	const long frame = frameIndex();
+	if(g_shotListFrame < 0) { g_shotListFrame = frame; return; } // started this frame: not sent yet
+	if(g_shotListFrame >= frame) return;
+	CBytestream bs;
+	if(sl->writePacket(&bs, cl->getClientVersion())) sl->Clear();
+	g_shotListFrame = -1;
+	bs.ResetPosToBegin();
+	// As CClient::ReadPackets: each packet is parsed (readSingle/readMulti) and processed.
+	while(cClient->getNetEngine()->ParsePacket(&bs)) {
+		if(!cClient->canSimulate()) continue;
+		CShootList* in = cClient->getShootList();
+		for(int i = 0; i < in->getNumShots(); i++) {
+			shoot_t* sh = in->getShot(i);
+			// spawnTime() reads the clock and serverFrame, which are still what ProcessShot saw.
+			if(sh) g_delivered.push_back(Delivered{*sh, sh->spawnTime()});
+		}
+	}
+}
+
+// Runs after each frame, once simulationTime has advanced (spec §18 D1, D10), in the
+// order a real local game at one frame per main-loop iteration handles them at the
+// start of the next iteration (CClient::ReadPackets, then GameServer::ReadPackets):
+//  1. every reliable message the server queued for the local client during the frame
+//     (bonus spawns and destruction, worm and weapon updates, ...), parsed by the client;
+//  2. the shot list, Model R;
+//  3. every reliable message the local client queued for the server during the frame
+//     (bonus grabs, damage reports, ...), parsed by the server.
+// Messages that step 3 makes the server queue go out after the next frame.
+void betweenFrames() {
+	if(!g_rec || !cServer || !cServer->isServerRunning()) return;
+	CServerConnection* cl = cServer->localClientConnection();
+	if(!cl) return;
+	PinnedClock pin;
+	const long frame = frameIndex();
+	std::list<CBytestream> toClient = takeMessages(cl->getChannel());
+	if(!toClient.empty())
+		notes << "OracleHooks: frame " << frame << ": server -> client" << messageTypes(toClient) << endl;
+	for(std::list<CBytestream>::iterator it = toClient.begin(); it != toClient.end(); ++it) {
+		it->ResetPosToBegin();
+		while(cClient->getNetEngine()->ParsePacket(&*it)) {}
+	}
+	deliverShots(cl);
+	std::list<CBytestream> toServer = takeMessages(cClient->getChannel());
+	if(!toServer.empty())
+		notes << "OracleHooks: frame " << frame << ": client -> server" << messageTypes(toServer) << endl;
+	for(std::list<CBytestream>::iterator it = toServer.begin(); it != toServer.end(); ++it) {
+		it->ResetPosToBegin();
+		cl->getNetEngine()->ParsePacket(&*it);
+	}
+}
+
+// Floats as JSON numbers with 9 significant digits (round-trips f32), or a string if not finite.
+static void f(FILE* o, float v) {
+	if(std::isnan(v)) fputs("\"NaN\"", o);
+	else if(std::isinf(v)) fputs(v > 0 ? "\"inf\"" : "\"-inf\"", o);
+	else fprintf(o, "%.9g", v);
+}
+
+// A time as ms since frame -1, or null if it was never set (AbsTime 0).
+static void t(FILE* o, AbsTime v) {
+	if(v == AbsTime()) fputs("null", o);
+	else fprintf(o, "%lld", (long long)v.milliseconds() - (long long)g_t0);
+}
+
+static unsigned long long materialHash() {
+	CMap* m = game.gameMap();
+	unsigned long long h = 14695981039346656037ULL; // FNV-1a 64 offset basis
+	if(!m || !m->material) return 0;
+	for(uint y = 0; y < m->GetHeight(); y++)
+		for(uint x = 0; x < m->GetWidth(); x++) {
+			h ^= m->material->line[y][x];
+			h *= 1099511628211ULL;
+		}
+	return h;
+}
+
+// JSON string with quotes and backslashes escaped.
+static void str(FILE* o, const std::string& s) {
+	fputc('"', o);
+	for(size_t i = 0; i < s.size(); i++) {
+		if(s[i] == '"' || s[i] == '\\') fputc('\\', o);
+		if((unsigned char)s[i] >= 0x20) fputc(s[i], o);
+	}
+	fputc('"', o);
+}
+
+// rl-data's slug(): lowercase ASCII letters and digits, one '-' for each run of anything else.
+static std::string slug(const std::string& s) {
+	std::string out;
+	bool dash = false;
+	for(size_t i = 0; i < s.size(); i++) {
+		unsigned char c = (unsigned char)s[i];
+		if(c < 0x80 && isalnum(c)) {
+			if(dash && !out.empty()) out += '-';
+			dash = false;
+			out += (char)tolower(c);
+		}
+		else
+			dash = true;
+	}
+	return out.empty() ? "unnamed" : out;
+}
+
+// Names a projectile and its children by their path, as rl-import-lgs does
+// before it shares identical definitions: "<weapon id>", then ".spawn" or ".trail".
+static void nameProjectile(const proj_t* p, const std::string& name, std::map<const proj_t*, std::string>& out) {
+	if(!p || out.count(p)) return;
+	out[p] = name;
+	nameProjectile(p->GeneralSpawnInfo.Proj, name + ".spawn", out);
+	if(p->Trail.Type == TRL_PROJECTILE) nameProjectile(p->Trail.Proj.Proj, name + ".trail", out);
+}
+
+static void writeNames(FILE* o, const std::vector<std::string>& names) {
+	fputc('[', o);
+	for(size_t i = 0; i < names.size(); i++) {
+		if(i) fputc(',', o);
+		str(o, names[i]);
+	}
+	fputc(']', o);
+}
+
+// First line of a recording: the OLX version, every gameplay setting in effect,
+// the mod's weapon and projectile names, other options and the seed.
+static void writeHeader(FILE* o) {
+	fputs("{\"olx\":", o);
+	str(o, GetFullGameName());
+	fputs(",\"features\":{", o);
+	for(size_t i = 0; i < featureArrayLen(); i++) {
+		if(i) fputc(',', o);
+		str(o, featureArray[i].name);
+		fputc(':', o);
+		str(o, cClient->getGameLobby()[(FeatureIndex)i].toString());
+	}
+	CGameScript* gs = game.gameScript();
+	std::vector<std::string> weapons;
+	std::map<const proj_t*, std::string> projNames;
+	std::vector<std::string> ids;
+	for(int i = 0; i < gs->GetNumWeapons(); i++) {
+		const weapon_t& wpn = gs->GetWeapons()[i];
+		weapons.push_back(wpn.Name);
+		// rl-import-lgs's weapon id: the slug, made unique with "-2", "-3", ...
+		std::string id = slug(wpn.Name);
+		for(int n = 2; std::find(ids.begin(), ids.end(), id) != ids.end(); n++)
+			id = slug(wpn.Name) + "-" + itoa(n);
+		ids.push_back(id);
+		if(wpn.Type == WPN_PROJECTILE) nameProjectile(wpn.Proj.Proj, id, projNames);
+	}
+	std::vector<std::string> projectiles(gs->getProjectileCount());
+	for(std::map<const proj_t*, std::string>::iterator it = projNames.begin(); it != projNames.end(); ++it) {
+		int i = gs->projectileIndex(it->first);
+		if(i >= 0 && (size_t)i < projectiles.size()) projectiles[i] = it->second;
+	}
+	fputs("},\"weapons\":", o);
+	writeNames(o, weapons);
+	fputs(",\"projectiles\":", o);
+	writeNames(o, projectiles);
+	fprintf(o, ",\"options\":{\"DoProjectileSimulationInDedicated\":\"%s\",\"Game.Blood\":\"%d\",\"Game.Particles\":\"%s\",\"K\":\"%d\",\"T0\":\"%llu\"}",
+		tLXOptions->doProjectileSimulationInDedicated ? "true" : "false", tLXOptions->iBloodAmount,
+		tLXOptions->bParticles ? "true" : "false", (int)CLOCK_OFFSET_MS, (unsigned long long)g_t0);
+	fprintf(o, ",\"seed\":%u}\n", g_seed);
+}
+
+static void writeShots(FILE* o) {
+	fputs(",\"s\":[", o);
+	for(size_t i = 0; i < g_delivered.size(); i++) {
+		const shoot_t& s = g_delivered[i].shot;
+		if(i) fputc(',', o);
+		fprintf(o, "{\"w\":%d,\"wpn\":%d,\"x\":", s.nWormID, s.nWeapon);
+		f(o, s.cPos.x); fputs(",\"y\":", o); f(o, s.cPos.y);
+		fputs(",\"vx\":", o); f(o, s.cWormVel.x); fputs(",\"vy\":", o); f(o, s.cWormVel.y);
+		fprintf(o, ",\"ang\":%d,\"rnd\":%d,\"spd\":%d,\"rel\":%s,\"t\":%llu,\"spawn\":",
+			s.nAngle, s.nRandom, s.nSpeed, s.release ? "true" : "false",
+			(unsigned long long)s.fTime.milliseconds());
+		t(o, g_delivered[i].spawn);
+		fputc('}', o);
+	}
+	fputc(']', o);
+	g_delivered.clear();
+}
+
+static void writeState(long frame) {
+	FILE* o = g_rec;
+	fprintf(o, "{\"f\":%ld,\"sf\":%ld,\"st\":", frame, (long)game.serverFrame);
+	t(o, game.simulationAbsTime());
+	fputs(",\"ct\":", o);
+	t(o, tLX->currentTime);
+	fprintf(o, ",\"rc\":%llu,\"mt\":%llu,\"ents\":%d", g_randCalls, rndDraws, (int)EntitiesUsed());
+	writeShots(o);
+	fputs(",\"w\":[", o);
+	bool first = true;
+	for_each_iterator(CWorm*, it, game.worms()) {
+		CWorm* w = it->get();
+		if(!first) fputc(',', o);
+		first = false;
+		const CNinjaRope& r = w->cNinjaRope.get();
+		fprintf(o, "{\"id\":%d,\"alive\":%s,\"x\":", w->getID(), w->getAlive() ? "true" : "false");
+		f(o, w->getPos().x); fputs(",\"y\":", o); f(o, w->getPos().y);
+		fputs(",\"vx\":", o); f(o, w->getVelocity().x); fputs(",\"vy\":", o); f(o, w->getVelocity().y);
+		fputs(",\"hp\":", o); f(o, w->getHealth());
+		fputs(",\"ang\":", o); f(o, w->getAngle()); fputs(",\"angv\":", o); f(o, Access::angleSpeed(w));
+		fprintf(o, ",\"face\":%d,\"move\":%d,\"ground\":%s,\"keys\":%u,\"wpn\":%d,\"slots\":[",
+			(int)w->getFaceDirectionSide(), (int)w->getMoveDirectionSide(), w->isOnGround() ? "true" : "false",
+			(unsigned)w->tState.get().asInt(), (int)w->iCurrentWeapon);
+		for(size_t i = 0; i < w->weaponSlots.get().size(); i++) {
+			const wpnslot_t& s = w->weaponSlots.get()[i];
+			if(i) fputc(',', o);
+			fprintf(o, "{\"id\":%d,\"ch\":", (int)s.WeaponId); f(o, s.Charge);
+			fprintf(o, ",\"rl\":%s,\"lf\":", s.Reloading ? "true" : "false"); f(o, s.LastFire);
+			fputc('}', o);
+		}
+		fprintf(o, "],\"rope\":{\"rel\":%s,\"sh\":%s,\"at\":%s,\"pw\":%d,\"x\":",
+			r.isReleased() ? "true" : "false", r.isShooting() ? "true" : "false",
+			r.isAttached() ? "true" : "false", r.getAttachedPlayer() ? r.getAttachedPlayer()->getID() : -1);
+		f(o, r.getPos().x); fputs(",\"y\":", o); f(o, r.getPos().y);
+		fputs(",\"vx\":", o); f(o, r.getVelocity().x); fputs(",\"vy\":", o); f(o, r.getVelocity().y);
+		fprintf(o, "},\"lives\":%d,\"kills\":%d,\"deaths\":%d,\"dirt\":%d,\"suicides\":%d,\"tod\":",
+			(int)w->getLives(), w->getKills(), w->getDeaths(), w->getDirtCount(), w->getSuicides());
+		// fTimeofDeath is a wall-clock time from CWorm::Prepare until the first death.
+		if(w->getAlive()) fputs("null", o); else t(o, w->getTimeofDeath());
+		fprintf(o, ",\"respawn\":%u,\"blood\":",
+			((bool)w->bRespawnRequested ? 1u : 0u) | ((bool)w->bCanRespawnNow ? 2u : 0u) | (w->haveSpawnedOnce() ? 4u : 0u));
+		t(o, w->getLastBlood());
+		fputc('}', o);
+	}
+	fputs("],\"p\":[", o);
+	first = true;
+	auto& ps = cClient->getProjectiles();
+	for(int i = 0; i <= ps.lastUsed(); i++) {
+		if(!ps.isUsed(i)) continue;
+		CProjectile& p = ps[i];
+		if(!first) fputc(',', o);
+		first = false;
+		fprintf(o, "{\"i\":%d,\"t\":%d,\"x\":", i, game.gameScript()->projectileIndex(p.getProjInfo()));
+		f(o, p.getPos().x); fputs(",\"y\":", o); f(o, p.getPos().y);
+		fputs(",\"vx\":", o); f(o, p.getVelocity().x); fputs(",\"vy\":", o); f(o, p.getVelocity().y);
+		fputs(",\"life\":", o); f(o, p.getLife());
+		fprintf(o, ",\"own\":%d,\"rnd\":%d,\"ls\":", p.GetOwner(), p.getRandomIndex());
+		t(o, p.fLastSimulationTime); fputs(",\"sp\":", o); t(o, Access::spawnTime(p));
+		fputs(",\"ig\":", o); t(o, p.getIgnoreWormCollBeforeTime());
+		fputs(",\"ws\":", o); f(o, Access::wallshootTime(p));
+		fputs(",\"tr\":", o); t(o, p.lastTrailProj());
+		const CVec op = Access::oldPos(p);
+		fputs(",\"ox\":", o); f(o, op.x); fputs(",\"oy\":", o); f(o, op.y);
+		fputs(",\"fr\":", o); f(o, p.frame());
+		const Color c = p.renderColorAt(0, 0);
+		fprintf(o, ",\"col\":%u}", ((unsigned)c.r << 16) | ((unsigned)c.g << 8) | (unsigned)c.b);
+	}
+	fputs("],\"b\":[", o);
+	first = true;
+	CBonus* bs = cClient->getBonusList();
+	for(int i = 0; i < MAX_BONUSES; i++) {
+		if(!bs[i].getUsed()) continue;
+		if(!first) fputc(',', o);
+		first = false;
+		fprintf(o, "{\"i\":%d,\"t\":%d,\"x\":", i, bs[i].getType());
+		f(o, bs[i].getPosition().x); fputs(",\"y\":", o); f(o, bs[i].getPosition().y);
+		fputs(",\"vx\":", o); f(o, bs[i].velocity().x); fputs(",\"vy\":", o); f(o, bs[i].velocity().y);
+		fputs(",\"life\":", o); f(o, bs[i].life());
+		fprintf(o, ",\"wpn\":%d}", bs[i].getWeapon());
+	}
+	fputs("],\"sb\":[", o);
+	first = true;
+	CBonus* sbs = Access::serverBonuses();
+	for(int i = 0; i < MAX_BONUSES; i++) {
+		if(!sbs[i].getUsed()) continue;
+		if(!first) fputc(',', o);
+		first = false;
+		fprintf(o, "{\"i\":%d,\"t\":%d,\"x\":", i, sbs[i].getType());
+		f(o, sbs[i].getPosition().x); fputs(",\"y\":", o); f(o, sbs[i].getPosition().y);
+		fprintf(o, ",\"wpn\":%d,\"spawn\":", sbs[i].getWeapon());
+		t(o, sbs[i].getSpawnTime());
+		fputc('}', o);
+	}
+	fputc(']', o);
+	// From the frame GameServer::GameOver ran in: its frame and winner.
+	if(game.gameOver)
+		fprintf(o, ",\"go\":{\"f\":%llu,\"w\":%d}", (unsigned long long)(uint64_t)game.gameOverFrame, g_gameOverWinner);
+	fprintf(o, ",\"mh\":\"%016llx\"}\n", materialHash());
+	fflush(o);
+}
+
+}
+
+void CWorm::replaceInputHandlerForTest(CWormInputHandler* h) {
+	if(m_inputHandler) m_inputHandler->deleteThis();
+	m_inputHandler = h;
+	m_inputHandler->assignNetworkRole();
+}
