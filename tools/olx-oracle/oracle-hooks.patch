diff --git a/src/common/OracleHooks.cpp b/src/common/OracleHooks.cpp
new file mode 100644
index 0000000..e552e46
--- /dev/null
+++ b/src/common/OracleHooks.cpp
@@ -0,0 +1,671 @@
+/*
+	OpenLieroX
+
+	Test hooks for the rust-liero fidelity oracle (see OracleHooks.h).
+
+	code under LGPL
+*/
+
+#include <algorithm>
+#include <cctype>
+#include <chrono>
+#include <cmath>
+#include <cstdio>
+#include <cstdlib>
+#include <fstream>
+#include <list>
+#include <map>
+#include <sstream>
+#include <vector>
+
+#include "LieroX.h"
+#include "OracleHooks.h"
+#include "CBytestream.h"
+#include "CChannel.h"
+#include "CClient.h"
+#include "CClientNetEngine.h"
+#include "CBonus.h"
+#include "CGameScript.h"
+#include "CInput.h"
+#include "CProjectile.h"
+#include "CServer.h"
+#include "CServerConnection.h"
+#include "CServerNetEngine.h"
+#include "CShootList.h"
+#include "CWormHuman.h"
+#include "Entity.h"
+#include "FeatureList.h"
+#include "Options.h"
+#include "ProjectileDesc.h"
+#include "StringUtils.h"
+#include "Version.h"
+#include "WeaponDesc.h"
+#include "game/CMap.h"
+#include "game/CWorm.h"
+#include "game/Game.h"
+#include "gusanos/allegro.h"
+#include "util/math_func.h"
+
+// rand() and srand() are interposed so the hooks can count rand() calls.
+// They delegate to random()/srandom(), as glibc's own rand()/srand() do,
+// so the sequence is unchanged.
+static unsigned long long g_randCalls = 0;
+extern "C" int rand(void) __THROW { ++g_randCalls; return (int)random(); }
+extern "C" void srand(unsigned int s) __THROW { srandom(s); }
+
+namespace OracleHooks {
+
+unsigned long long rndDraws = 0;
+
+struct Keys {
+	VirtualKey up, down, left, right, jump, fire, rope, change, strafe, prev, next;
+};
+
+struct Event { int worm; unsigned mask; };
+struct BonusEvent { int x, y; std::string kind, weapon; };
+
+static std::map<int, Keys> g_keys;                       // worm id -> scripted keys
+static std::map<long, std::vector<Event> > g_plan;       // frame -> key changes
+static std::map<long, std::vector<BonusEvent> > g_bonusPlan; // frame -> bonuses to place
+static long g_base = -1;                                 // serverFrame before frame 0
+static FILE* g_rec = NULL;
+static FILE* g_timing = NULL;          // ORACLE_TIMING: "frame ns projectiles rc" lines (rust-liero plan 8)
+static bool g_headerOnly = false;      // ORACLE_HEADER_ONLY: the trace keeps the header and frame -1
+static std::chrono::steady_clock::time_point g_frameStart;
+static unsigned int g_seed = 0;
+static Uint64 g_t0 = 0;                // simulationTime (ms) at frame -1; trace times are relative to it
+static long g_shotListFrame = -1;      // frame in which the pending shot list was started
+struct Delivered { shoot_t shot; AbsTime spawn; };
+static std::vector<Delivered> g_delivered; // shots processed before the next frame
+static std::string g_failure;          // first failure during the recording
+static bool g_pinned = false;
+static int g_gameOverWinner = -1;   // GameServer::GameOver's winner
+static AbsTime g_wallTime;             // tLX->currentTime while it is pinned
+
+// Reads state that has no public getter (the classes declare this a friend).
+struct Access {
+	static float angleSpeed(const CWorm* w) { return w->fAngleSpeed; }
+	static AbsTime spawnTime(const CProjectile& p) { return p.fSpawnTime; }
+	static float wallshootTime(const CProjectile& p) { return p.fWallshootTime; }
+	static CVec oldPos(const CProjectile& p) { return p.vOldPos; }
+	static CBonus* serverBonuses() { return cServer->cBonuses; }
+	static void setLastBonusTime(AbsTime t) { cServer->fLastBonusTime = t; }
+};
+
+static void writeHeader(FILE* o);
+static void writeState(long frame);
+
+static AbsTime pinnedTime() { return game.simulationAbsTime() + TimeDiff(CLOCK_OFFSET_MS); }
+
+// Pins tLX->currentTime to the simulation clock for its lifetime.
+struct PinnedClock {
+	AbsTime saved;
+	PinnedClock() : saved(tLX->currentTime) { tLX->currentTime = pinnedTime(); }
+	~PinnedClock() { tLX->currentTime = saved; }
+};
+
+static void fail(const std::string& msg) {
+	errors << "OracleHooks: " << msg << endl;
+	if(g_failure.empty()) g_failure = msg;
+}
+
+static void setKey(VirtualKey& k, bool down) {
+	// A press is latched until the next getInput() resets it, like CInput's
+	// nDown (counts as held) and nDownOnce (counts as pressed once).
+	if(down && !k.down) k.once = k.pressed = true;
+	k.down = down;
+}
+
+static void apply(Keys& k, unsigned m) {
+	setKey(k.up, m & KEY_UP);
+	setKey(k.down, m & KEY_DOWN);
+	setKey(k.left, m & KEY_LEFT);
+	setKey(k.right, m & KEY_RIGHT);
+	setKey(k.jump, m & KEY_JUMP);
+	setKey(k.fire, m & KEY_FIRE);
+	setKey(k.rope, m & KEY_ROPE);
+	setKey(k.change, m & KEY_CHANGE);
+}
+
+static CWorm* localWorm(int wormId, std::string& err) {
+	CWorm* w = game.wormById(wormId, false);
+	if(!w) { err = "no worm " + itoa(wormId); return NULL; }
+	if(!w->getLocal()) { err = "worm " + itoa(wormId) + " is not local"; return NULL; }
+	return w;
+}
+
+static bool installHumanHandler(int wormId, Keys& keys, std::string& err) {
+	CWorm* w = localWorm(wormId, err);
+	if(!w) return false;
+	CWormHumanInputHandler* h = dynamic_cast<CWormHumanInputHandler*>(w->inputHandler());
+	if(!h) {
+		h = new CWormHumanInputHandler(w);
+		w->replaceInputHandlerForTest(h);
+	}
+	h->getInputUp().virt = &keys.up;
+	h->getInputDown().virt = &keys.down;
+	h->getInputLeft().virt = &keys.left;
+	h->getInputRight().virt = &keys.right;
+	h->getInputJump().virt = &keys.jump;
+	h->getInputShoot().virt = &keys.fire;
+	h->getInputRope().virt = &keys.rope;
+	h->getInputWeapon().virt = &keys.change;
+	h->getInputStrafe().virt = &keys.strafe;
+	h->getInputPrevWeapon().virt = &keys.prev;
+	h->getInputNextWeapon().virt = &keys.next;
+	return true;
+}
+
+static bool bonusType(const std::string& kind, int& type, std::string& err) {
+	if(kind == "health") type = BNS_HEALTH;
+	else if(kind == "weapon") type = BNS_WEAPON;
+	else { err = "bonus kind must be health or weapon, not " + kind; return false; }
+	return true;
+}
+
+bool loadInputs(const std::string& file, std::string& err) {
+	std::ifstream in(file.c_str());
+	if(!in) { err = "cannot open " + file; return false; }
+	g_plan.clear();
+	g_bonusPlan.clear();
+	std::string line;
+	while(std::getline(in, line)) {
+		if(line.empty() || line[0] == '#') continue;
+		std::istringstream ls(line);
+		long frame; std::string what;
+		if(!(ls >> frame >> what)) { err = "bad line: " + line; return false; }
+		if(what == "bonus") {
+			BonusEvent b; int type;
+			if(!(ls >> b.x >> b.y >> b.kind)) { err = "bad bonus line: " + line; return false; }
+			std::getline(ls, b.weapon);
+			TrimSpaces(b.weapon);
+			if(!bonusType(b.kind, type, err)) return false;
+			if(type == BNS_WEAPON && game.gameScript()->FindWeaponId(b.weapon) < 0) {
+				err = "no weapon '" + b.weapon + "'"; return false;
+			}
+			g_bonusPlan[frame].push_back(b);
+			continue;
+		}
+		bool bad = false;
+		int worm = from_string<int>(what, bad);
+		unsigned mask;
+		if(bad || !(ls >> mask)) { err = "bad line: " + line; return false; }
+		g_plan[frame].push_back(Event{worm, mask});
+		if(!g_keys.count(worm) && !installHumanHandler(worm, g_keys[worm], err)) return false;
+	}
+	// Every worm is driven by the schedule, so no bot AI runs (spec §18 D8).
+	for_each_iterator(CWorm*, it, game.worms()) {
+		int id = it->get()->getID();
+		if(!g_keys.count(id) && !installHumanHandler(id, g_keys[id], err)) return false;
+	}
+	g_base = (long)game.serverFrame;
+	// The simulation clock starts where OLX happened to be after startup. Restart it
+	// at a fixed time, then align the LX56 physics clock (84 Hz) with it, so frame 0
+	// does not catch up on however much time the setup took (as simStep does once).
+	game.setSimulationTimeForTest(AbsTime((Uint64)START_TIME_MS));
+	if(cClient) cClient->fLastSimulationTime = game.simulationAbsTime();
+	return true;
+}
+
+bool record(const std::string& file, std::string& err) {
+	if(g_rec) {
+		fclose(g_rec); g_rec = NULL;
+		if(g_timing) { fclose(g_timing); g_timing = NULL; }
+		if(!g_failure.empty()) { err = "the recording failed: " + g_failure; return false; }
+	}
+	if(file == "off") return true;
+	g_rec = fopen(file.c_str(), "w");
+	if(!g_rec) { err = "cannot write " + file; return false; }
+	// Bench only (rust-liero plan 8): frame times to a file of their own, so
+	// the trace is untouched; a header-only trace for the timed runs.
+	if(const char* path = getenv("ORACLE_TIMING")) {
+		g_timing = fopen(path, "w");
+		if(!g_timing) { err = std::string("cannot write ") + path; return false; }
+	}
+	g_headerOnly = getenv("ORACLE_HEADER_ONLY") != NULL;
+	if(g_base < 0) g_base = (long)game.serverFrame;
+	g_t0 = game.simulationAbsTime().milliseconds();
+	notes << "OracleHooks: recording from simulationTime " << g_t0 << " ms, serverFrame " << game.serverFrame << endl;
+	g_shotListFrame = -1;
+	g_delivered.clear();
+	g_failure.clear();
+	PinnedClock pin;
+	// The dedicated server never frees entities, so the pool fills up for good.
+	// Start each recording from an empty pool and a known bonus timer.
+	ClearEntities();
+	Access::setLastBonusTime(tLX->currentTime);
+	writeHeader(g_rec);
+	writeState(-1); // the state frame 0 starts from
+	return true;
+}
+
+bool active() { return g_rec != NULL; }
+
+void seed(unsigned int s) {
+	g_seed = s;
+	rndgen.seed(s);
+	rnd.base().seed(s);
+	midrnd.engine().seed(s);
+	g_randCalls = 0;
