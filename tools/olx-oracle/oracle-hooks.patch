diff --git a/include/OracleHooks.h b/include/OracleHooks.h
new file mode 100644
index 0000000..67859eb
--- /dev/null
+++ b/include/OracleHooks.h
@@ -0,0 +1,73 @@
+/*
+	OpenLieroX
+
+	Test hooks for the rust-liero fidelity oracle.
+	Scripted keyboard input for worms and per-frame state recording,
+	used with simSetSeed/simStep to record reference traces.
+
+	code under LGPL
+*/
+
+#ifndef __ORACLEHOOKS_H__
+#define __ORACLEHOOKS_H__
+
+#include <string>
+
+namespace OracleHooks {
+	// Key bits used by the input schedule (simLoadInputs).
+	enum {
+		KEY_UP = 1, KEY_DOWN = 2, KEY_LEFT = 4, KEY_RIGHT = 8,
+		KEY_JUMP = 16, KEY_FIRE = 32, KEY_ROPE = 64, KEY_CHANGE = 128,
+	};
+	// While recording, tLX->currentTime = simulationTime + CLOCK_OFFSET_MS
+	// during each frame and during shot delivery (rust-liero spec §18 D2).
+	enum { CLOCK_OFFSET_MS = 10 };
+	// simLoadInputs restarts simulationTime at this value, so code that measures
+	// time since 0 (bleeding, relative air jumps) does not depend on how long
+	// OLX took to start.
+	enum { START_TIME_MS = 100000 };
+
+	// Loads the schedule: "frame worm keys" lines, and "frame bonus x y health|weapon [name]"
+	// lines. Frame 0 is the first frame simulated after this call. Every worm switches
+	// to a human input handler driven by the schedule (no bot AI). Also restarts the
+	// simulation clock at START_TIME_MS and aligns the LX56 physics clock with it;
+	// spawn worms after this call.
+	// Returns false and sets err on failure.
+	bool loadInputs(const std::string& file, std::string& err);
+	// Starts writing one JSON line per simulated frame to file ("off" stops).
+	// "off" also reports a failure that happened during the recording.
+	// Bench only (rust-liero plan 8): with ORACLE_TIMING=<file> in the environment, each
+	// recorded frame's wall time (from the end of beforeFrame() to the start of
+	// afterFrame()), projectile count and rand() calls go to that file as
+	// "frame ns projectiles rc" lines; with ORACLE_HEADER_ONLY set, the trace keeps only
+	// the header and frame -1. Without them nothing changes. Shot-list delivery and
+	// message parsing run in betweenFrames(), after afterFrame(), so they fall outside
+	// the timed span (rust-liero's World::tick does the equivalent inside its tick).
+	bool record(const std::string& file, std::string& err);
+	// True while a recording is armed: the clock is pinned, and shots and the local
+	// connection's reliable messages are delivered by betweenFrames() instead of
+	// GameServer::SendUpdate and the network.
+	bool active();
+	// Called by simSetSeed after srand(): reseeds the FindSpot MT19937 streams
+	// (rnd, rndgen, midrnd) and restarts the rand()/rnd() counters.
+	void seed(unsigned int s);
+	// simSetWeapons: "name0,name1,...,cur=k", one name per weapon slot.
+	bool setWeapons(int wormId, const std::string& spec, std::string& err);
+	bool setHealth(int wormId, float hp, std::string& err);
+	// Spawns a bonus through GameServer::SpawnBonus at (x, y) and delivers its
+	// packet to the local client at once. kind is "health" or "weapon".
+	bool placeBonus(int x, int y, const std::string& kind, const std::string& weapon, std::string& err);
+	// Called by the game loop around each simulated frame, and after
+	// simulationTime advanced: delivers the local connection's reliable messages
+	// of that frame in both directions and the shot list (Model R; spec §18 D1, D10).
+	void beforeFrame();
+	void afterFrame();
+	void betweenFrames();
+	// GameServer::GameOver: the winner it computed (Winner()), recorded as the
+	// frames' "go" field from then on.
+	void onGameOver(int winner);
+	// rnd() draws, counted in CMap::FindSpot.
+	extern unsigned long long rndDraws;
+}
+
+#endif
