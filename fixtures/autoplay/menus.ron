// The menus end to end (spec §7, §21 G7; plan 7 Review Focus 4): main menu,
// local play, OLX's weapon selection, a match with scripted keys and a
// pause, its results, the replay it saved watched at 16× and max
// (fast-forward), the options' window sizes changed quickly (the paced
// size changes), and quit. `xtask e2e` runs it on Xvfb with --fake-clock
// (20 ms and two ticks a frame) from `settings.ron`.
(
    steps: [
        (ui: WaitFor("Main")),
        (ui: Screenshot("main")),
        (ui: Click("Local Play")),
        (ui: WaitFor("LocalPlay")),
        (ui: Assert(Label("Dirt Level"))),
        (ui: Screenshot("local-play")),
        (ui: Click("Start")),
        (ui: WaitFor("WeaponSelect"), within: 300),
        (ui: Click("Random")),
        (ui: Screenshot("weapons")),
        (ui: Click("Done")),
        (ui: WaitFor("InGame")),
        (ui: Assert(Playing(true))),
        (ui: Assert(Speed("1"))),
        // Walk, shoot, jump.
        (ui: Press(Right)),
        (ui: Press(Shoot)),
        (ui: Wait(60)),
        (ui: Release(Shoot)),
        (ui: Press(Jump)),
        (ui: Wait(5)),
        (ui: Release(Jump)),
        (ui: Release(Right)),
        // A played game never runs fast.
        (ui: Key("PageUp")),
        (ui: Assert(Speed("1"))),
        (ui: Press(Left)),
        (ui: Press(Shoot)),
        (ui: Wait(40)),
        (ui: Screenshot("match")),
        (ui: Release(Shoot)),
        (ui: Release(Left)),
        (ui: Assert(TicksAtLeast(200))),
        // Pause, and back.
        (ui: Key("Escape")),
        (ui: Click("Resume")),
        (ui: WaitFor("InGame")),
        // The 30 s time limit, then OLX's 3 s of "Game Over".
        (ui: WaitFor("Results"), within: 2000),
        (ui: Screenshot("results")),
        (ui: Click("Back to menu")),
        (ui: WaitFor("Main")),
        (ui: Assert(Playing(false))),
        // The match's replay, saved when it ended, watched fast.
        (ui: Click("Replays")),
        (ui: WaitFor("Replays")),
        (ui: Click("match-000001.rlrp")),
        (ui: WaitFor("InGame"), within: 300),
        (ui: Key("PageUp")),
        (ui: Key("PageUp")),
        (ui: Key("PageUp")),
        (ui: Key("PageUp")),
        (ui: Assert(Speed("16"))),
        (ui: Wait(10)),
        (ui: Screenshot("replay-16x")),
        (ui: Key("PageUp")),
        (ui: Assert(Speed("max"))),
        (ui: Key("PageDown")),
        (ui: Key("PageUp")),
        (ui: WaitFor("Results"), within: 400),
        (ui: Click("Back to menu")),
        (ui: WaitFor("Main")),
        // Window sizes from the options, changed quickly: the window follows
        // at most every 250 ms (the paced requests), the latest wins.
        (ui: Click("Options")),
        (ui: WaitFor("Options")),
        (ui: Click("Display")),
        (ui: Click("1600 × 900")),
        (ui: Wait(20)),
        (ui: Assert(WindowSize(1600, 900))),
        (ui: Click("Display")),
        (ui: Click("1920 × 1080")),
        (ui: Click("Display")),
        (ui: Click("1280 × 720")),
        (ui: Wait(20)),
        (ui: Assert(WindowSize(1280, 720))),
        (ui: Screenshot("options")),
        (ui: Click("Back")),
        (ui: WaitFor("Main")),
        (ui: Click("Quit")),
        (ui: WaitForExit, within: 60),
    ],
)
