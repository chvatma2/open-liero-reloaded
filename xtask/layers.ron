// Crate layering (spec §4). A crate may depend on crates in lower layers, and on
// same-layer crates only when the pair is listed in `same_layer`. Every
// workspace crate must be listed here. `no_std` crates must declare
// #![no_std]; `wasm` crates must build for wasm32-unknown-unknown.
(
    layers: {
        "olr-math": 0,
        "olr-data": 1,
        "olr-terrain": 1,
        "olr-vfs": 1,
        "olr-pack": 2,
        "olr-format": 2,
        "olr-import-lgs": 2,
        "olr-import-lxl": 2,
        "olr-import-gfx": 2,
        "olr-oracle": 2,
        "olr-import": 3,
        "olr-edit": 3,
        "olr-sim": 3,
        "olr-modes": 3,
        "olr-bots": 3,
        "olr-replay": 3,
        "olr-proto": 4,
        "olr-netcode": 4,
        "olr-lobby": 4,
        "olr-scenario": 4,
        "olr-content": 4,
        "olr-scene": 5,
        "olr-fx": 5,
        "olr-render": 5,
        "olr-present": 5,
        "olr-audio": 5,
        "olr-input": 5,
        "olr-ui": 5,
        "olr-editor": 5,
        "olr-net": 5,
        "olr-discovery": 5,
        "olr-online": 5,
        "olr-cli": 6,
        "olr-server": 6,
        "olr-game": 6,
        "olr-detcheck": 6,
        "xtask": 6,
    },
    same_layer: [
        ("olr-terrain", "olr-data"),
        // Game modes implement the simulation's `GameMode` (spec §20 F6).
        ("olr-modes", "olr-sim"),
        // Bots read a `World` and press its `Keys` (spec §20 F3, F7).
        ("olr-bots", "olr-sim"),
        // Replays rebuild a `World` and its game mode (spec §20 F8).
        ("olr-replay", "olr-sim"),
        ("olr-replay", "olr-modes"),
        // Packs read and write images through the authoring crate (plan 13b).
        ("olr-pack", "olr-format"),
        ("olr-import-lgs", "olr-pack"),
        ("olr-import-lxl", "olr-pack"),
        ("olr-import-gfx", "olr-pack"),
        // The importer makes level thumbnails with the authoring crate's (plan 13d).
        ("olr-import-gfx", "olr-format"),
        // The oracle replays worlds built from packs the way the game loads them.
        ("olr-scenario", "olr-content"),
        // Cosmetic entities draw into the scene's draw list with its atlas ids.
        ("olr-fx", "olr-scene"),
        // The renderer draws the scene's draw list from its atlas images.
        ("olr-render", "olr-scene"),
        // One viewport's presentation wires the scene, the entities and their
        // upload to the renderer in the frame loop's order, once for every
        // mode (sandbox, matches, replays, `olr-cli render`).
        ("olr-present", "olr-scene"),
        ("olr-present", "olr-fx"),
        ("olr-present", "olr-render"),
        // The options menu edits the key bindings (plan 7 task 1).
        ("olr-ui", "olr-input"),
        // The session speaks the wire format.
        ("olr-netcode", "olr-proto"),
        // The lobby's identity signs the wire format's keys and signatures.
        ("olr-lobby", "olr-proto"),
        // The lobby addresses peers by the netcode's ids and computes their
        // input delay with it (peer ids and input delay).
        ("olr-lobby", "olr-netcode"),
        // Online play drives the real transport's endpoint.
        ("olr-online", "olr-net"),
        // Online play drives the Nostr handshakes too (ruling N55): the
        // joiner's relay pool and `Asker`, the host's `Inbox`, TURN notes;
        // one join and one listener for the game, the server and olr-cli.
        ("olr-online", "olr-discovery"),
        // The real-transport tests run the dedicated server in-process
        // (plan 10 ruling PF2).
        ("olr-cli", "olr-server"),
    ],
    no_std: ["olr-math", "olr-data", "olr-terrain", "olr-sim", "olr-modes", "olr-bots", "olr-replay", "olr-proto", "olr-netcode", "olr-lobby"],
    wasm: ["olr-math", "olr-data", "olr-terrain", "olr-sim", "olr-modes", "olr-bots", "olr-replay", "olr-proto", "olr-netcode", "olr-lobby", "olr-vfs", "olr-format", "olr-pack", "olr-import-lgs", "olr-import-lxl", "olr-import-gfx"],
    forbidden: [
        // The game, the server and the UI ship without legacy importers (spec §5).
        ("olr-game", "olr-import"), ("olr-game", "olr-import-lgs"), ("olr-game", "olr-import-lxl"), ("olr-game", "olr-import-gfx"),
        ("olr-server", "olr-import"), ("olr-server", "olr-import-lgs"), ("olr-server", "olr-import-lxl"), ("olr-server", "olr-import-gfx"),
        ("olr-ui", "olr-import"), ("olr-ui", "olr-import-lgs"), ("olr-ui", "olr-import-lxl"), ("olr-ui", "olr-import-gfx"),
    ],
)
