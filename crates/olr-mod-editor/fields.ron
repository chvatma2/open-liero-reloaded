// The mod editor's field table (issue #17), written by `cargo xtask
// format-docs` from olr-format's types: `key`, `ty` and `help` (the doc
// comment) are generated, `check` fails when they drift from the format.
// Edit `unit` (shown in the label), `range` (the slider's soft range; any
// value may be typed), `place` (Common, More: under More, or Panel: drawn
// by the editor's own panels) and `asset` (`gfx` or `sfx`: a dropdown of
// the mod's files); writing the table again keeps them.
[
    (
        key: "ModFile.name",
        ty: "String",
        unit: "",
        range: None,
        place: Common,
        asset: None,
        help: "Shown in menus; bot loadouts and weapon restrictions match on it (OLX: the lgs header\'s `ModName`, `CGameScript.cpp`, header bytes 24..88).",
    ),
    (
        key: "ModFile.notes",
        ty: "String",
        unit: "",
        range: None,
        place: Common,
        asset: None,
        help: "Free text for authors; ignored by the game.",
    ),
    (
        key: "ModFile.worm",
        ty: "Worm",
        unit: "",
        range: None,
        place: Panel,
        asset: None,
        help: "Worm physics (`mod-fields.md` §3).",
    ),
    (
        key: "ModFile.rope",
        ty: "Rope",
        unit: "",
        range: None,
        place: Panel,
        asset: None,
        help: "Ninja rope (`mod-fields.md` §4).",
    ),
    (
        key: "ModFile.weapons",
        ty: "Vec<String>",
        unit: "",
        range: None,
        place: Panel,
        asset: None,
        help: "The weapon ids, in order: `weapons/<id>.ron` each; a weapon\'s index is its id in the game. At most `MAX_WEAPONS` (512).",
    ),
    (
        key: "ModFile.loadouts",
        ty: "BTreeMap<String,ShippedLoadout>",
        unit: "",
        range: None,
        place: Panel,
        asset: None,
        help: "The mod\'s shipped loadouts (read-only in the game; every mod also has `Default`, every weapon at 100 %), each keyed by the name of a preset of `restrictions.ron`: the weapons that preset enables (Bonus and Banned off), at its loading time. Not an OLX field: OLX set `LoadingTime` apart from the preset. At most `MAX_LOADOUTS` (64).",
    ),
    (
        key: "ModFile.look",
        ty: "Option<ModWideLookSource>",
        unit: "",
        range: None,
        place: Panel,
        asset: None,
        help: "The mod\'s look as a whole: the explosion light and heat of every projectile without its own. Presentation only. Default none.",
    ),
    (
        key: "Weapon.name",
        ty: "String",
        unit: "",
        range: None,
        place: Common,
        asset: None,
        help: "Shown in menus; restrictions and bot loadouts match on it (OLX `name`).",
    ),
    (
        key: "Weapon.notes",
        ty: "String",
        unit: "",
        range: None,
        place: Common,
        asset: None,
        help: "Free text for authors; ignored by the game.",
    ),
    (
        key: "Weapon.recharge",
        ty: "f32",
        unit: "magazines/s",
        range: Some((0.0, 2.0)),
        place: Common,
        asset: None,
        help: "Full magazines per second at LoadingTime 100 % (OLX stores the file\'s value ÷ 10, `CGameScript.cpp:777`; this is that value).",
    ),
    (
        key: "Weapon.drain",
        ty: "f32",
        unit: "%",
        range: Some((0.0, 100.0)),
        place: Common,
        asset: None,
        help: "Percent of a full magazine used per shot (> 100 empties it) (OLX `drain`, `CServer_Game.cpp:395-410`).",
    ),
    (
        key: "Weapon.between_shots_s",
        ty: "f32",
        unit: "s",
        range: Some((0.0, 2.0)),
        place: Common,
        asset: None,
        help: "Seconds between shots (OLX\'s `ROF` ÷ 1000, `CGameScript.cpp:776`).",
    ),
    (
        key: "Weapon.laser_sight",
        ty: "bool",
        unit: "",
        range: None,
        place: Common,
        asset: None,
        help: "Spawns a laser-sight entity every sub-step while the weapon is not reloading; the entity takes an entity-pool slot, so it counts in the simulation (OLX `CClient_Game.cpp:751-808`).",
    ),
    (
        key: "Weapon.fire",
        ty: "Fire",
        unit: "",
        range: None,
