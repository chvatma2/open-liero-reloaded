        unit: "px",
        range: Some((0.0, 16.0)),
        place: More,
        asset: None,
        help: "Collision box in px (OLX `width`, `height`; radius = half). Default (2, 2) for `Pixels`, (4, 4) for `Image` (`CGameScript.cpp:873-878`).",
    ),
    (
        key: "Projectile.gravity",
        ty: "Option<i32>",
        unit: "px/s²",
        range: Some((-200.0, 300.0)),
        place: Common,
        asset: None,
        help: "px/s² added to the vertical velocity (OLX `ProjGravity`); absent = the world\'s gravity (100). `0` and `100` are written: they are not \"absent\" (`mod-fields.md` §1.4).",
    ),
    (
        key: "Projectile.velocity_factor",
        ty: "f32",
        unit: "× a step",
        range: Some((0.9, 1.1)),
