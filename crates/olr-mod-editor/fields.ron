    (
        key: "Projectile.hit_terrain",
        ty: "Vec<Effect>",
        unit: "",
        range: None,
        place: Panel,
        asset: None,
        help: "When the projectile hits rock or dirt (OLX `Hit`). `[]` = OLX\'s `Nothing`. The effect kind also selects the collision physics: `Bounce`, `Nothing` (half-move), `GoThrough` (no stop), `Explode` in dirt only (keeps position); everything else stops at the last safe position (`mod-fields.md` §7). At most `MAX_EFFECTS` (16).",
    ),
    (
        key: "Projectile.hit_worm",
        ty: "Vec<Effect>",
        unit: "",
        range: None,
        place: Panel,
        asset: None,
        help: "When it hits a worm (OLX `PlayerHit`). `[]` = `Nothing`, which also turns worm collision off; `GoThrough` hits but does not stop. At most `MAX_EFFECTS` (16).",
    ),
