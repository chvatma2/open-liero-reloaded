    ),
    (
        key: "Weapon.look",
        ty: "Option<crate::look::WeaponLookSource>",
        unit: "",
        range: None,
        place: Panel,
        asset: None,
        help: "The weapon\'s look (look system): its muzzle light. Default none.",
    ),
    (
        key: "Projectile.id",
        ty: "Option<String>",
        unit: "",
        range: None,
        place: More,
