                heat: (
                    capacity: 140,
                    conductivity: 80,
                    cooling: 80,
                ),
            ),
            (
                id: "metal",
                name: "Metal",
                notes: "Steel: heat runs far through it, so a blast warms a wide patch less; it sheds heat fast to the air.",
                heat: (
                    capacity: 80,
                    conductivity: 600,
                    cooling: 150,
                ),
            ),
            (
                id: "wood",
                name: "Wood",
                notes: "Smoulders: warms easily, keeps its heat where it lands and glows like embers.",
                heat: (
                    capacity: 50,
