(
    name: "Assassin\'s Shot",
    recharge: 0.2,
    drain: 101.0,
    between_shots_s: 5.0,
    fire: Projectile(
        recoil: 15,
        sound: "sfx/shot.ogg",
        shot: (
            speed: 250,
            projectile: (
                gfx: Image(
                    file: "gfx/assassin.png",
                    animation: (
                        fps: 1.0,
                        mode: Loop,
                    ),
                ),
                gravity: 0,
                timer: (
                    after_s: 20.0,
                    effects: [
                        Explode(
                            damage: 5,
                        ),
                    ],
                ),
                trail: Projectile(
                    every_s: 150.0,
                    spawn: (
                        speed: 10,
                        spread: 360.0,
                        projectile: (
                            gfx: Image(
                                file: "gfx/shells.png",
                                rotating: true,
                                rotation_step_deg: 90,
                                rotation_speed: 400,
                            ),
                            timer: (
                                after_s: 1.75,
                                variation_s: 0.25,
                                effects: [
                                    Explode(
                                        damage: -1,
                                    ),
                                    Spawn("spawn"),
                                ],
                            ),
                            hit_terrain: [
                                Bounce(),
                            ],
                            spawns: {
                                "spawn": (
                                    speed: 15,
                                    angle: 90,
                                    shared: "assassin-s-shot.trail.spawn",
                                ),
                            },
                        ),
                    ),
                ),
                hit_terrain: [
                    Bounce(
                        factor: 1.0,
                    ),
                ],
                hit_worm: [
                    Injure(
                        damage: 100,
                    ),
                ],
            ),
        ),
    ),
)
