(
    name: "Smoking Bomb",
    recharge: 0.2,
    drain: 101.0,
    between_shots_s: 5.0,
    fire: Projectile(
        class: Grenade,
        recoil: 5,
        sound: "sfx/throw.ogg",
        shot: (
            speed: 100,
            projectile: (
                gfx: Image(
                    file: "gfx/smokebomb3.png",
                    animation: (
                        fps: 10.0,
                        mode: Loop,
                    ),
                ),
                timer: (
                    after_s: 0.5,
                    effects: [
                        Explode(
                            damage: 4,
                            shake: 4,
                        ),
                        Spawn("spawn"),
                    ],
                ),
                hit_terrain: [
                    Bounce(),
                ],
                spawns: {
                    "spawn": (
                        speed: 15,
                        angle: 90,
                        projectile: (
                            gfx: Image(
                                file: "gfx/gauss.png",
                            ),
                            gravity: -15,
                            timer: (
                                after_s: 5.0,
                                effects: [
                                    Explode(
                                        damage: 3,
                                        shake: 2,
                                    ),
                                ],
                            ),
                            trail: Projectile(
                                every_s: 0.0075,
                                spawn: (
                                    speed: 60,
                                    speed_var: 15.0,
                                    spread: 360.0,
                                    projectile: (
                                        gfx: Image(
                                            file: "gfx/blacksmoke.png",
                                            animation: (
                                                fps: 10.0,
                                            ),
                                        ),
                                        gravity: -30,
                                        hit_terrain: [
                                            Bounce(),
                                        ],
                                        hit_worm: [
                                            Injure(
                                                damage: 15,
                                            ),
                                        ],
                                    ),
                                ),
                            ),
                            hit_terrain: [
                                Bounce(),
                            ],
                        ),
                    ),
                },
            ),
        ),
    ),
)
