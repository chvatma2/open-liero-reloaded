// OpenLieroX content imported by `cargo xtask fetch-olx-content` (spec §9.3).
// Paths are relative to `share/gamedir` at `commit`. Git verifies every file
// against the commit hash. Remove a line to stop bundling that item.
(
    repository: "https://github.com/openlierox/openlierox.git",
    commit: "d1ad953f4f20610f2648cce26c9739e7c088409d",
    shared: ["data/gfx", "data/sounds"],
    mods: ["Classic", "MW 1.0"],
    levels: [
        "levels/Liero Factory.lxl",
        "levels/CastleStrike.lxl",
        "levels/FossilFacility.lxl",
        "levels/Dirt Level.lxl",
    ],
    themes: ["data/themes/Dirt"],
    skins: true,
    // The core pack `olx-core` (spec §19 E9): shared game sprites, the game
    // sounds and the frontend colours. Mod packs keep their own sounds.
    core: [
        "data/gfx/crosshair.png",
        "data/gfx/muzzle.png",
        "data/gfx/explosion.png",
        "data/gfx/smoke.png",
        "data/gfx/chemsmoke.png",
        "data/gfx/spawn.png",
        "data/gfx/sparkle.png",
        "data/gfx/giblets.png",
        "data/gfx/hook.png",
        "data/gfx/bonus.png",
        "data/gfx/health.png",
        "data/sounds/throw.ogg",
        "data/sounds/pickup.ogg",
        "data/sounds/bump.ogg",
        "data/sounds/death1.ogg",
        "data/sounds/death2.ogg",
        "data/sounds/death3.ogg",
        "data/frontend/colours.cfg",
    ],
)
